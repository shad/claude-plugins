#!/usr/bin/env python3
"""Group sidebar rows by the feature their session is working on.

Shell cwd cannot answer this. Sessions read in the main checkout and write in a
worktree, so cwd says the same repo for all of them. The transcript records the
worktree, so that is what we read.

Grouping is additive. It creates a group and adds a row. It never moves a row
out, dissolves a group, or undoes a placement a person made.

  cmux-sidebar-sync          group rows, set PR pills, report
  cmux-sidebar-sync --check  report only
  cmux-sidebar-sync --hook   quiet, never fails

See references/sidebar-semantics.md.
"""
import glob
import json
import os
import pathlib
import re
import subprocess
import sys
import time

CACHE = pathlib.Path.home() / ".cache" / "cmux-sidebar-sync"
PR_TTL = 60


def run(*cmd, cwd=None, timeout=15):
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=cwd, timeout=timeout)
    return r.stdout if r.returncode == 0 else ""


def cmux(*args):
    return run("cmux", *args)


def session_of(tty):
    """The Claude session id cmux passed on the command line, via the tty.
    Fresh sessions get --session-id; resumed ones get --resume."""
    for line in run("ps", "-t", tty, "-o", "command=").splitlines():
        m = re.search(r"--(?:session-id|resume)\s+([0-9a-f-]{36})", line)
        if m:
            return m.group(1)
    return None


def transcript_of(session_id):
    hits = glob.glob(str(pathlib.Path.home() / ".claude/projects/*" / f"{session_id}.jsonl"))
    return hits[0] if hits else None


def recorded(session_id):
    """What the PostToolUse hook saw this session touch. Ground truth."""
    f = CACHE / "session" / session_id
    try:
        repo, feature = f.read_text().strip().split("\t")
        return repo, feature
    except (OSError, ValueError):
        return None


def feature_of(transcript):
    """The last worktree the session entered. Not the last cwd — a session that
    finished has returned to the main checkout."""
    out = run("grep", "-o", r'"cwd":"[^"]*worktrees/[^"]*"', transcript)
    if not out:
        return None
    path = out.strip().splitlines()[-1].split('"')[3]
    m = re.match(r"(.*?)/(?:\.claude/)?\.?worktrees/([^/]+)", path)
    return (m.group(1), m.group(2)) if m else None


def repo_root(path):
    """The main checkout, even from inside a worktree."""
    common = run("git", "rev-parse", "--path-format=absolute", "--git-common-dir",
                 cwd=path).strip()
    if common.endswith("/.git"):
        return common[:-5]
    return run("git", "rev-parse", "--show-toplevel", cwd=path).strip() or None


def prs_for(repo):
    """One gh call per repo, cached. No PR number is stored locally, so the
    branch is the only join."""
    CACHE.mkdir(parents=True, exist_ok=True)
    f = CACHE / (re.sub(r"\W+", "_", repo) + ".json")
    if f.exists() and time.time() - f.stat().st_mtime < PR_TTL:
        return json.loads(f.read_text())
    out = run("gh", "pr", "list", "--state", "all", "--limit", "50", "--json",
              "number,headRefName,state,isDraft,reviewDecision", cwd=repo, timeout=20)
    prs = {}
    for pr in json.loads(out or "[]"):
        state = "draft" if pr["isDraft"] else pr["state"].lower()
        if pr.get("reviewDecision") == "APPROVED":
            state = "approved"
        prs[pr["headRefName"]] = f"#{pr['number']} {state}"
    f.write_text(json.dumps(prs))
    return prs


def branch_of(repo, slug):
    for p in (f"{repo}/.git/worktrees/{slug}/HEAD",):
        try:
            head = open(p).read().strip()
        except OSError:
            continue
        if head.startswith("ref: refs/heads/"):
            return head[len("ref: refs/heads/"):]
    return None


def main():
    hook = "--hook" in sys.argv
    apply_ = "--check" not in sys.argv
    notes, acted = [], []

    try:
        rows = json.loads(cmux("workspace", "list", "--json") or '{"workspaces":[]}')["workspaces"]
        cwds = {w["ref"]: w.get("current_directory") for w in rows}
        tree = json.loads(cmux("tree", "--all", "--json") or "{}")
        groups = json.loads(cmux("workspace-group", "list", "--json") or '{"groups":[]}')["groups"]
    except (json.JSONDecodeError, KeyError):
        return 0 if hook else 2

    # First terminal tab of each row. One row is one job; tab 1 owns it.
    ttys = {}
    for win in tree.get("windows", []):
        for ws in win.get("workspaces", []):
            for pane in ws.get("panes", []):
                for surf in pane.get("surfaces", []):
                    if surf.get("type") == "terminal" and surf.get("tty"):
                        ttys.setdefault(ws["ref"], surf["tty"])
                        break

    by_name = {g["name"]: g for g in groups}
    grouped = {r for g in groups for r in g["member_workspace_refs"]}

    for ws, tty in sorted(ttys.items()):
        sid = session_of(tty)
        if not sid:
            continue
        found = recorded(sid)
        if not found:
            t = transcript_of(sid)
            found = feature_of(t) if t else None
        if not found:
            # No worktree evidence. The row is working in the main checkout, so
            # that is where it belongs — a bucket, not a feature.
            root = repo_root(cwds.get(ws) or "")
            if not root:
                continue
            found = (root, "main")
        repo, feature = found
        name = f"{os.path.basename(repo)} · {feature}"

        if ws in grouped and by_name.get(name, {}).get("member_workspace_refs", []) and \
                ws in by_name[name]["member_workspace_refs"]:
            continue
        if ws in grouped:
            # A `· main` bucket is not a placement, it is the absence of one.
            # Evidence of a feature outranks it. Every other group is permanent.
            here = next((g for g in groups if ws in g["member_workspace_refs"]), None)
            if not (here and here["name"].endswith("· main") and feature != "main"):
                notes.append(f"{ws} works in {feature} but sits elsewhere — left alone")
                continue
            if not apply_:
                notes.append(f'{ws} moves from "{here["name"]}" to "{name}"')
                continue
            cmux("workspace-group", "remove", "--workspace", ws)
            grouped.discard(ws)
            acted.append(f'{ws} promoted out of "{here["name"]}"')

        if not apply_:
            notes.append(f"{ws} belongs in \"{name}\"")
            continue

        if name not in by_name:
            path = f"{repo}/.worktrees/{feature}"
            cmux("workspace-group", "create", "--name", name,
                 "--cwd", path if os.path.isdir(path) else repo)
            groups = json.loads(cmux("workspace-group", "list", "--json"))["groups"]
            by_name = {g["name"]: g for g in groups}
            acted.append(f'created "{name}"')
        g = by_name.get(name)
        if g:
            cmux("workspace-group", "add", "--group", g["ref"], "--workspace", ws)
            grouped.add(ws)
            acted.append(f'{ws} → "{name}"')

    # PR state is a pill. Group headers do not render pills, only name and icon,
    # so it goes on the member rows.
    for g in json.loads(cmux("workspace-group", "list", "--json") or '{"groups":[]}')["groups"]:
        if "·" not in g["name"]:
            continue
        anchor = g["anchor_workspace_ref"]
        feature = g["name"].split("·")[-1].strip()
        if feature == "main":
            continue
        repo = next((r for r in (os.path.expanduser(f"~/projects/{g['name'].split('·')[0].strip()}"),)
                     if os.path.isdir(r)), None)
        if not repo or not apply_:
            continue
        branch = branch_of(repo, feature)
        if not branch:
            continue
        try:
            pr = prs_for(repo).get(branch)
        except Exception:
            continue
        if pr:
            for ws in g["member_workspace_refs"]:
                if ws != anchor:
                    cmux("set-status", "pr", pr, "--workspace", ws,
                         "--icon", "arrow.triangle.branch")
            acted.append(f'{g["name"]}: pr = {pr}')

    if hook:
        if acted:
            print(f"sidebar: {len(acted)} change(s)")
        return 0
    for line in acted:
        print(f"did     {line}")
    for line in notes:
        print(f"note    {line}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        if "--hook" in sys.argv:
            sys.exit(0)
        print(f"cmux-sidebar-sync: {e}", file=sys.stderr)
        sys.exit(2)
