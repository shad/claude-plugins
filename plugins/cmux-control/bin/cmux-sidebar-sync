#!/usr/bin/env python3
"""Enforce the mechanical half of the sidebar contract.

Fixes what is decidable from state alone (color follows group, ungrouped rows
carry no color, anchor titles match group names) and reports what needs
judgment (titles that read like prompts, dead groups, rows holding two streams)
without guessing at it.

  cmux-sidebar-sync            apply fixes, print drift needing judgment
  cmux-sidebar-sync --check    report only, change nothing
  cmux-sidebar-sync --quiet    suppress the applied-fix lines
  cmux-sidebar-sync --hook     apply silently, one summary line, never fail

Exit 0 clean, 1 drift needs judgment, 2 cmux unreachable. --hook always
exits 0: a hook that fails on a messy sidebar is worse than a messy sidebar.
See references/sidebar-semantics.md for what each rule is enforcing.
"""
import json
import re
import subprocess
import sys

STATUS_WORDS = re.compile(
    r"\b(wip|todo|done|doing|blocked|pending|in.progress|fixme|urgent|asap)\b", re.I
)
TITLE_MAX = 24


def cmux(*args):
    r = subprocess.run(("cmux",) + args, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(f"cmux {' '.join(args)}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout


def main():
    hook = "--hook" in sys.argv
    apply_fixes = "--check" not in sys.argv
    quiet = hook or "--quiet" in sys.argv
    try:
        workspaces = json.loads(cmux("workspace", "list", "--json"))["workspaces"]
        groups = json.loads(cmux("workspace-group", "list", "--json"))["groups"]
    except (RuntimeError, json.JSONDecodeError, KeyError) as e:
        if "--hook" in sys.argv:
            return 0  # not running under cmux, or cmux is down; say nothing
        print(f"cmux-sidebar-sync: {e}", file=sys.stderr)
        return 2

    by_ref = {w["ref"]: w for w in workspaces}
    group_of = {}
    for g in groups:
        for ref in g["member_workspace_refs"]:
            group_of[ref] = g

    fixed, drift = [], []

    for g in groups:
        members = [by_ref[r] for r in g["member_workspace_refs"] if r in by_ref]
        anchor = by_ref.get(g["anchor_workspace_ref"])
        hue = g.get("custom_color")

        # A group is a stream; a stream has a hue and a kind.
        if not hue:
            drift.append(f"{g['ref']} \"{g['name']}\" has no color — pick a hue for the stream")
        if not g.get("icon_symbol"):
            drift.append(f"{g['ref']} \"{g['name']}\" has no icon — name the kind of arc")

        # An anchor-only group is a header over nothing.
        if len(members) <= 1:
            drift.append(
                f"{g['ref']} \"{g['name']}\" has no members besides its anchor — "
                f"dissolve it or move its work in"
            )

        # The anchor row is the header; its title should read as the group.
        if anchor and anchor.get("custom_title") != g["name"]:
            if apply_fixes:
                cmux("workspace-action", "--action", "rename",
                     "--workspace", anchor["ref"], "--title", g["name"])
                fixed.append(f"{anchor['ref']} title := \"{g['name']}\" (anchor follows group)")
            else:
                drift.append(f"{anchor['ref']} anchor title != group name \"{g['name']}\"")

        # Color is the stream: the group tints only its header, so members
        # without their own hue show no stripe at all.
        if hue:
            for w in members:
                if w["ref"] == g["anchor_workspace_ref"]:
                    continue
                if (w.get("custom_color") or "").upper() != hue.upper():
                    if apply_fixes:
                        cmux("workspace-action", "--action", "set-color",
                             "--workspace", w["ref"], "--color", hue)
                        fixed.append(f"{w['ref']} color := {hue} ({g['name']})")
                    else:
                        drift.append(f"{w['ref']} color != its group's {hue}")

    for w in workspaces:
        ref, title = w["ref"], w.get("custom_title") or ""
        g = group_of.get(ref)

        # Belonging to no stream is a state with a look: no color.
        if not g and w.get("custom_color"):
            if apply_fixes:
                cmux("workspace-action", "--action", "clear-color", "--workspace", ref)
                fixed.append(f"{ref} color cleared (ungrouped rows carry no hue)")
            else:
                drift.append(f"{ref} is ungrouped but colored")

        if g and w["ref"] == g["anchor_workspace_ref"]:
            continue  # the anchor is a header, not a row of work

        if not w.get("has_custom_title"):
            drift.append(f"{ref} is auto-named \"{title}\" — needs a `role · object` title")
        else:
            if len(title) > TITLE_MAX:
                drift.append(f"{ref} title is {len(title)} chars — \"{title}\"")
            if STATUS_WORDS.search(title):
                drift.append(f"{ref} title carries state, not identity — \"{title}\"")
            if g:
                # Only the group's identifying tokens count as a repeat: its
                # repo name and its ticket numbers. Sharing an ordinary word
                # ("status" in a group about bin/status) is not duplication.
                ident = {g["name"].split("·")[0].strip().lower()}
                ident |= set(re.findall(r"#\d+", g["name"]))
                shared = {t for t in ident if t and t in title.lower()}
                if shared:
                    drift.append(
                        f"{ref} title repeats its group ({', '.join(sorted(shared))}) — \"{title}\""
                    )

        if w.get("pinned"):
            drift.append(f"{ref} is pinned — a pin is temporary and scarce; still earning it?")

        if not g and w.get("current_directory"):
            for other in groups:
                anchor = by_ref.get(other["anchor_workspace_ref"])
                if anchor and anchor.get("current_directory") == w["current_directory"]:
                    drift.append(
                        f"{ref} is ungrouped but shares a directory with \"{other['name']}\""
                    )
                    break

    # A row is one unit of work; extra tabs may be companions or a second stream.
    try:
        tree = cmux("tree", "--all")
        current = None
        counts = {}
        for line in tree.splitlines():
            m = re.search(r"workspace (workspace:\d+)", line)
            if m:
                current = m.group(1)
            elif current and "surface:" in line and "[terminal]" in line:
                counts[current] = counts.get(current, 0) + 1
        for ref, n in counts.items():
            if n > 1:
                drift.append(
                    f"{ref} holds {n} tabs — companions to one job, or a second stream to split out?"
                )
    except RuntimeError:
        pass

    if hook:
        if drift:
            print(
                f"sidebar: {len(drift)} item(s) need judgment "
                f"(run /cmux-control:tidy-sidebar to clean up)"
            )
        return 0

    if fixed and not quiet:
        for line in fixed:
            print(f"fixed   {line}")
    for line in drift:
        print(f"drift   {line}")

    if drift:
        if not quiet:
            print(
                f"\n{len(drift)} item(s) need judgment — run /cmux-control:tidy-sidebar",
                file=sys.stderr,
            )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
